---
import Base from "../layouts/Base.astro";
import ServiceCards from "../components/ServiceCards.astro";
import FaqList from "../components/FaqList.astro";
import QuoteForm from "../components/QuoteForm.astro";
import { pageSchema } from "../data/schema";
import { businessName, homeFaqs, phoneDisplay, phoneTel } from "../data/site";
import { locations } from "../data/locations";

const title = "Fence Company Beaumont TX | Vinyl Fence, Wood Fence, Aluminum Fence & More";
const description =
  "JD's Fence Company installs wood, vinyl, chain-link, aluminum, farm, and commercial fences in Beaumont, TX. Call (409) 254-6532 for a free estimate.";
const crumbs = [{ name: "Home", path: "/" }];
const schema = pageSchema({
  path: "/",
  title,
  description,
  crumbs,
  faqs: homeFaqs,
});
---

<Base title={title} description={description} path="/" schema={schema}>
  <section class="hero hero-home">
    <img class="hero-media" src="/images/hero.jpg" alt="Brown wooden privacy fence beside evergreen trees under a blue sky" width="2400" height="1600" fetchpriority="high" />
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <h1>Fence Company Beaumont TX</h1>
        <p>
          JD's Fence Company provides professional residential and commercial fence installation throughout Beaumont, TX, and surrounding communities. We specialize in <a href="/wood-fence.html">wood privacy fences</a>, <a href="/vinyl-fence.html">vinyl fencing</a>, <a href="/chain-link-fence.html">chain-link fences</a>, <a href="/aluminum-fence.html">aluminum fencing</a>, <a href="/farm-fence.html">farm fencing</a>, and <a href="/commercial-fencing.html">commercial security fences</a>. Whether you're replacing an old fence, adding privacy to your backyard, or securing a commercial property, our crew plans the line around your lot, gates, and ground conditions. Every job starts with an on-site measurement, so the written quote matches your property instead of a guess. We build each line for Southeast Texas clay, humidity, and local city rules. Contact us today for a free fence estimate.
        </p>
        <div class="actions">
          <a class="btn" href="#quote">Request a free quote</a>
          <a class="btn btn-line" href={`tel:${phoneTel}`}>Call {phoneDisplay}</a>
        </div>
      </div>
      <QuoteForm embedded heading="Get a free quote" />
    </div>
    <div class="hero-brand">
      <div class="wrap hero-brand-inner">
        <a class="hero-logo" href="/" aria-label={`${businessName} home`}>
          <svg viewBox="0 0 48 48" aria-hidden="true">
            <rect width="48" height="48" rx="10" fill="#1B4332"></rect>
            <path d="M8 38V20l5-7 5 7v18" stroke="#F3EDE3" stroke-width="2.4" stroke-linejoin="round"></path>
            <path d="M19 38V16l5-7 5 7v22" stroke="#F3EDE3" stroke-width="2.4" stroke-linejoin="round"></path>
            <path d="M30 38V22l5-7 5 7v16" stroke="#F3EDE3" stroke-width="2.4" stroke-linejoin="round"></path>
            <path d="M7 38h34" stroke="#E07A3D" stroke-width="2.4" stroke-linecap="round"></path>
          </svg>
          <span>
            <strong>JD's Fence Company</strong>
            <em>Beaumont, TX</em>
          </span>
        </a>
      </div>
    </div>
  </section>

  <section class="section band-sand">
    <div class="wrap">
      <div class="section-head">
        <h2>Why Choose Us</h2>
        <p>Local fence work priced from the property, with materials matched to the job—not a one-size panel for every yard.</p>
      </div>
      <ul class="why-grid">
        <li>
          <h3>On-site estimates</h3>
          <p>We look at the line, the soil, and the openings before we write a number. Photos help start the conversation. They do not set the price.</p>
        </li>
        <li>
          <h3>Six fence types</h3>
          <p>Wood, vinyl, chain link, aluminum, farm, and commercial fencing—so the material fits privacy, pets, pools, acreage, or a shop yard.</p>
        </li>
        <li>
          <h3>Built for Southeast Texas</h3>
          <p>Wet clay, Gulf humidity, and local city rules shape how posts are set and which fence belongs on your lot.</p>
        </li>
        <li>
          <h3>Clear next steps</h3>
          <p>Request an estimate, get a written quote, then schedule installation when you are ready. Call {phoneDisplay} anytime.</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="section band-white">
    <div class="wrap">
      <div class="section-head">
        <h2>Our Fence Services</h2>
        <p>Wood, vinyl, aluminum, chain link, farm, and commercial fencing with short descriptions, photos, and links to each page.</p>
      </div>
      <ServiceCards />
    </div>
  </section>

  <section class="section band-sage">
    <div class="wrap">
      <div class="section-head">
        <h2>Our Process</h2>
        <p>Four clear steps from the first call to a finished fence line.</p>
      </div>
      <ol class="process-grid">
        <li>
          <span>1</span>
          <h3>Request a quote</h3>
          <p>Call {phoneDisplay} or send the quote form with your city, the fence type, and a rough length.</p>
        </li>
        <li>
          <span>2</span>
          <h3>Discuss the project</h3>
          <p>We talk through the job and evaluate the property on site so material, gates, and ground conditions are clear.</p>
        </li>
        <li>
          <span>3</span>
          <h3>Receive your estimate</h3>
          <p>You get a written estimate for the material and openings measured on your lot.</p>
        </li>
        <li>
          <span>4</span>
          <h3>Schedule installation</h3>
          <p>When you approve the estimate, we schedule the crew and build the fence on your property.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="section band-mist">
    <div class="wrap">
      <div class="section-head">
        <h2>Areas We Serve</h2>
        <p>Beaumont and nearby Southeast Texas communities we can measure in person.</p>
      </div>
      <ul class="town-chips town-chips-light">
        {locations.map((location) => (
          <li><a href={`/${location.slug}.html`}>{location.city}</a></li>
        ))}
      </ul>
      <p class="towns-more towns-more-dark"><a href="/service-areas.html">See all service areas</a></p>
    </div>
  </section>

  <FaqList faqs={homeFaqs} heading="Frequently Asked Questions" tone="sand" />

  <section class="section band-cta">
    <div class="wrap">
      <div class="final">
        <h2>Request a Free Quote</h2>
        <p>Tell us the city, the fence type if you know it, and about how long the line is. Or call {phoneDisplay} and talk it through.</p>
        <div class="actions">
          <a class="btn" href="#quote">Request a free quote</a>
          <a class="btn btn-line" href={`tel:${phoneTel}`}>Call {phoneDisplay}</a>
        </div>
      </div>
    </div>
  </section>
</Base>
