---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import { pageSchema } from "../data/schema";
import { phoneDisplay } from "../data/site";
import { locations } from "../data/locations";

const title = "Fence Service Areas around Beaumont, TX";
const description =
  "JD's Fence Company serves Beaumont, Port Arthur, Nederland, Port Neches, Groves, Orange, Vidor, Lumberton, and Bridge City. Call (409) 254-6532.";
const path = "/service-areas.html";
const crumbs = [
  { name: "Home", path: "/" },
  { name: "Service Areas", path },
];
const schema = pageSchema({ path, title, description, crumbs });

const notes: Record<string, string> = {
  "beaumont-tx": "City lots, privacy fences, and the 6-foot permit rule.",
  "port-arthur-tx": "Homes plus commercial yards. Permits start around 4 feet.",
  "nederland-tx": "Close-set lots where the gate and the rear easement matter.",
  "port-neches-tx": "Residential privacy along the river, often replacing a damp wood line.",
  "groves-tx": "Dog runs, side-yard chain link, and rear-line privacy.",
  "orange-tx": "In-town yards and county acreage, under Orange's own rules.",
  "vidor-tx": "Larger lots, pines, and a mix of house fence and field fence.",
  "lumberton-tx": "Hardin County privacy lines and pasture fence.",
  "bridge-city-tx": "Humid residential streets and a few highway-front yards.",
};
---

<Base title={title} description={description} path={path} schema={schema}>
  <div class="crumb-bar">
    <nav class="wrap crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a> / <span aria-current="page">Service Areas</span>
    </nav>
  </div>

  <PageHero
    title="Fence service areas"
    lede={`JD's Fence Company measures and installs in Beaumont and the Southeast Texas towns listed below. Each page covers the fence jobs we see in that city. It also notes the local permit rule to check first. Rules differ from town to town, so we confirm the address before we build. Call ${phoneDisplay} if your address is nearby and you do not see it listed.`}
    eyebrow="Southeast Texas"
    image="/images/farm.jpg"
    imageAlt="Ranch rail fence along open land in Southeast Texas"
  />

  <section class="section band-white">
    <div class="wrap">
      <ul class="area-grid">
        {locations.map((location) => (
          <li>
            <a class="area-card" href={`/${location.slug}.html`}>
              <h2>{location.city}, TX</h2>
              <p>{notes[location.slug]}</p>
              <span class="more">{location.county}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
