---
import Base from "../layouts/Base.astro";
import ServiceCards from "../components/ServiceCards.astro";
import PageHero from "../components/PageHero.astro";
import { pageSchema } from "../data/schema";
import { phoneDisplay } from "../data/site";

const title = "Fence Installation Services in Beaumont, TX";
const description =
  "Wood, vinyl, chain link, aluminum, farm, and commercial fence installation from JD's Fence Company in Beaumont, TX. Call (409) 254-6532.";
const path = "/services.html";
const crumbs = [
  { name: "Home", path: "/" },
  { name: "Services", path },
];
const schema = pageSchema({ path, title, description, crumbs });
---

<Base title={title} description={description} path={path} schema={schema}>
  <div class="crumb-bar">
    <nav class="wrap crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a> / <span aria-current="page">Services</span>
    </nav>
  </div>

  <PageHero
    title="Fence services in Beaumont"
    lede={`JD's Fence Company installs six fence types around Beaumont, each built for a different job. Start with what the fence has to do, then open the matching page. Each page covers install steps, cost factors, and common questions. You can request a free quote from any of them. Call ${phoneDisplay} if you want help choosing a material.`}
    eyebrow="Beaumont, TX"
    image="/images/vinyl.jpg"
    imageAlt="Vinyl fence along a residential lawn"
  />

  <section class="section band-white">
    <div class="wrap">
      <ServiceCards />
    </div>
  </section>
</Base>
