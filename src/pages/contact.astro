---
import Base from "../layouts/Base.astro";
import QuoteForm from "../components/QuoteForm.astro";
import { pageSchema } from "../data/schema";
import { phoneDisplay } from "../data/site";

const title = "Contact JD's Fence Company | Beaumont, TX";
const description =
  "Request a free fence quote in Beaumont, TX or call JD's Fence Company at (409) 254-6532. Tell us the city and the approximate length.";
const path = "/contact.html";
const crumbs = [
  { name: "Home", path: "/" },
  { name: "Contact", path },
];
const schema = pageSchema({ path, title, description, crumbs });
---

<Base title={title} description={description} path={path} schema={schema} crumbs={crumbs}>
  <section class="page-hero">
    <div class="wrap narrow">
      <p class="eyebrow">Beaumont, TX</p>
      <h1>Contact JD's Fence Company</h1>
      <p class="lede">Call <a href="tel:+14092546532">{phoneDisplay}</a> or send the quote form. Include the city, the material if you know it, and roughly how much fence you need.</p>
      <p>Estimates are free. We are a service-area company based in Beaumont and do not keep a walk-in showroom. If the job is outside the towns on our <a href="/service-areas.html">service areas</a> page, say so in the form and we will tell you whether we can take it.</p>
      <div class="actions">
        <a class="btn btn-dark" href="tel:+14092546532">Call {phoneDisplay}</a>
      </div>
    </div>
  </section>
  <QuoteForm />
</Base>
