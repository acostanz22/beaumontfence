---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import { pageSchema } from "../data/schema";
import { phoneDisplay } from "../data/site";

const title = "Contact JD's Fence Company | Beaumont, TX";
const description =
  "Request a free fence quote in Beaumont, TX or call JD's Fence Company at (409) 254-6532. Tell us the city and the approximate length.";
const path = "/contact.html";
const crumbs = [
  { name: "Home", path: "/" },
  { name: "Contact", path },
];
const schema = pageSchema({ path, title, description, crumbs });
---

<Base title={title} description={description} path={path} schema={schema}>
  <div class="crumb-bar">
    <nav class="wrap crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a> / <span aria-current="page">Contact</span>
    </nav>
  </div>

  <PageHero
    title="Contact JD's Fence Company"
    lede={`JD's Fence Company gives free estimates on fence work in Beaumont and the surrounding towns. Call ${phoneDisplay} or use the quote form to get started. Include the city, the material if you know it, and roughly how much fence you need. We review those details and follow up with the next step toward a written quote. Estimates are free, and we will tell you plainly whether the job is a repair or a replacement.`}
    eyebrow="Beaumont, TX"
    image="/images/aluminum.jpg"
    imageAlt="Black ornamental fence along a landscaped property"
  />

  <section class="section band-paper">
    <div class="wrap narrow">
      <p>We are a service-area company based in Beaumont and do not keep a walk-in showroom. If the job is outside the towns on our <a href="/service-areas.html">service areas</a> page, say so in the form and we will tell you whether we can take it.</p>
      <p class="side-hours">Office hours: Monday–Sunday, 7 am – 7 pm</p>
    </div>
  </section>
</Base>
