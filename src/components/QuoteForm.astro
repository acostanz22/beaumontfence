---
import { phoneDisplay, tallySrc } from "../data/site";

interface Props {
  heading?: string;
  id?: string;
  embedded?: boolean;
}
const { heading = "Request a free quote", id = "quote", embedded = false } = Astro.props;
---

{embedded ? (
  <div class="quote-card" id={id}>
    <h2>{heading}</h2>
    <iframe
      data-tally-src={tallySrc}
      loading="lazy"
      width="100%"
      height="552"
      frameborder="0"
      marginheight="0"
      marginwidth="0"
      title="GET A FREE QUOTE"></iframe>
  </div>
) : (
  <section class="quote-band" id={id}>
    <div class="wrap">
      <div class="quote-card">
        <h2>{heading}</h2>
        <iframe
          data-tally-src={tallySrc}
          loading="lazy"
          width="100%"
          height="552"
          frameborder="0"
          marginheight="0"
          marginwidth="0"
          title="GET A FREE QUOTE"></iframe>
        <p class="fine">Prefer the phone? <a href="tel:+14092546532">{phoneDisplay}</a></p>
      </div>
    </div>
  </section>
)}
