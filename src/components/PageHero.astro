---
import QuoteForm from "./QuoteForm.astro";
import { phoneDisplay, phoneTel } from "../data/site";

interface Props {
  title: string;
  lede: string;
  eyebrow?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
}
const {
  title,
  lede,
  eyebrow,
  image = "/images/hero.jpg",
  imageAlt = "Fence installation project in Southeast Texas",
  imageWidth = 2400,
  imageHeight = 1350,
} = Astro.props;
---

<section class="page-hero hero-slim">
  <img
    class="hero-media"
    src={image}
    alt={imageAlt}
    width={imageWidth}
    height={imageHeight}
    loading="eager"
    decoding="async"
    fetchpriority="high"
  />
  <div class="wrap hero-grid hero-grid-slim">
    <div class="hero-copy">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{title}</h1>
      <p>{lede}</p>
      <div class="actions">
        <a class="btn" href="#quote">Request a free quote</a>
        <a class="btn btn-line" href={`tel:${phoneTel}`}>Call {phoneDisplay}</a>
      </div>
    </div>
    <QuoteForm embedded heading="Get a free quote" />
  </div>
</section>
