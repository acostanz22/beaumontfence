---
import type { Faq } from "../data/services";

interface Props {
  faqs: Faq[];
  heading?: string;
  tone?: "paper" | "white" | "sand" | "sage" | "ink" | "mist";
}
const { faqs, heading = "Frequently Asked Questions", tone = "paper" } = Astro.props;
const band = `section band-${tone}`;
const light = tone === "ink";
---

<section class={band} id="faq">
  <div class="wrap narrow faq-wrap">
    <div class={`section-head${light ? " section-head-light" : ""}`}>
      <h2>{heading}</h2>
      <p>Straight answers about cost, materials, permits, and gates before you request a quote.</p>
    </div>
    <div class={`faq-list${light ? " faq-list-light" : ""}`}>
      {faqs.map((faq) => (
        <details class="faq-item">
          <summary>{faq.q}</summary>
          <p>{faq.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
