---
import type { Faq } from "../data/services";

interface Props {
  faqs: Faq[];
  heading?: string;
}
const { faqs, heading = "Questions before you call" } = Astro.props;
---

<section class="section">
  <div class="wrap narrow">
    <h2>{heading}</h2>
    {faqs.map((faq) => (
      <article class="faq-item">
        <h3>{faq.q}</h3>
        <p>{faq.a}</p>
      </article>
    ))}
  </div>
</section>
