---
import Base from "../layouts/Base.astro";
import PageHero from "./PageHero.astro";
import { pageSchema } from "../data/schema";
import { phoneDisplay, phoneTel } from "../data/site";
import { services, type Service } from "../data/services";
import { locations } from "../data/locations";

interface Props {
  service: Service;
}
const { service } = Astro.props;
const path = `/${service.slug}.html`;
const crumbs = [
  { name: "Home", path: "/" },
  { name: "Services", path: "/services.html" },
  { name: service.name, path },
];
const schema = pageSchema({
  path,
  title: service.title,
  description: service.description,
  crumbs,
  faqs: service.faqs,
  service: { name: service.name, description: service.description },
});

const estimate = "#quote";
const others = services.filter((item) => item.slug !== service.slug);
const second = others[(services.findIndex((item) => item.slug === service.slug)) % others.length];
const relatedServices = others.slice(0, 4);
---

<Base title={service.title} description={service.description} path={path} schema={schema}>
  <div class="crumb-bar">
    <nav class="wrap crumbs" aria-label="Breadcrumb">
      {crumbs.map((crumb, index) => (
        <span>
          {index > 0 && " / "}
          {index === crumbs.length - 1 ? (
            <span aria-current="page">{crumb.name}</span>
          ) : (
            <a href={crumb.path}>{crumb.name}</a>
          )}
        </span>
      ))}
    </nav>
  </div>

  <PageHero
    title={service.h1}
    lede={service.intro}
    eyebrow={service.name}
    image={service.image}
    imageAlt={service.imageAlt}
  />

  <section class="section band-white service-body">
    <div class="wrap service-layout">
      <div class="service-main">
        <div class="service-gallery">
          <figure class="service-shot">
            <img src={service.whenImage} alt={service.whenAlt} width={service.whenWidth} height={service.whenHeight} loading="lazy" decoding="async" />
          </figure>
          <figure class="service-shot">
            <img src={second.image} alt={second.imageAlt} width={second.width} height={second.height} loading="lazy" decoding="async" />
          </figure>
        </div>

        <div class="service-copy">
          <h2>{service.whenTitle}</h2>
          <p>{service.when}</p>

          <h2>How the install goes</h2>
          <ol class="steps">
            {service.process.map((step, index) => (
              <li class="step">
                <span>Step {index + 1}</span>
                <h3>{step.h}</h3>
                <p>{step.p}</p>
              </li>
            ))}
          </ol>

          <h2>What changes the price</h2>
          <p>We quote after measuring. These are the details that move a {service.name.toLowerCase()} price.</p>
          <ul class="factors">
            {service.costs.map((cost) => (
              <li class="factor">
                <h3>{cost.h}</h3>
                <p>{cost.p}</p>
              </li>
            ))}
          </ul>

          <h2>Questions before you call</h2>
          {service.faqs.map((faq) => (
            <article class="faq-item">
              <h3>{faq.q}</h3>
              <p>{faq.a}</p>
            </article>
          ))}
        </div>
      </div>

      <aside class="service-aside" aria-label="Estimate and related services">
        <div class="side-card">
          <p class="side-kicker">Talk through the line</p>
          <p>Call or send the address and a rough length. We will tell you whether the job is a repair, a replacement, or a different material than you started with.</p>
          <p class="side-phone"><a class="phone-link-lg" href={`tel:${phoneTel}`}>{phoneDisplay}</a></p>
          <p class="side-hours">Monday–Sunday: 7 am – 7 pm</p>
          <p><a class="btn btn-dark" href={estimate}>Free quote form</a></p>
        </div>
        <div class="side-card side-card-muted">
          <p class="side-kicker">Related</p>
          <ul class="side-links">
            {relatedServices.map((item) => (
              <li><a href={`/${item.slug}.html`}>{item.name}</a></li>
            ))}
            <li><a href="/services.html">All services</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <section class="section band-sage section-towns">
    <div class="wrap">
      <h2>Areas we serve</h2>
      <ul class="related">
        {locations.map((loc) => (
          <li><a href={`/${loc.slug}.html`}>{loc.city}</a></li>
        ))}
        <li><a href="/service-areas.html">All service areas</a></li>
      </ul>
      <p class="towns-links"><a href={estimate}>Request a free quote</a> · <a href="/services.html">All services</a></p>
    </div>
  </section>
</Base>
